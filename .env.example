MQTT_URL=wss://mqtt1.meshcore.cz/feed
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=meshcore/+/+/packets
MQTT_KEEPALIVE=30
MQTT_RECONNECT_MS=3000
MQTT_RECONNECT_MAX_MS=60000

# Serverová perzistence tras (SQLite)
PACKET_DB_PATH=data/packets.sqlite
PACKET_RETENTION_MS=604800000
PACKET_MAX_ROWS=500000
PACKET_COLLECT_MS=300000

# Interní statistika návštěv
VISITS_DB_PATH=data/visits.sqlite

# Zpětná vazba
FEEDBACK_DB_PATH=data/feedback.sqlite
FEEDBACK_TOKEN=
FEEDBACK_RATE_LIMIT=15
FEEDBACK_DAILY_LIMIT=300
FEEDBACK_MAX_ROWS=5000
FEEDBACK_COOLDOWN_MS=30000

# Fotky nodů (mimo zálohy, mimo git)
PHOTO_DIR=uploads
PHOTO_MAX_BYTES=5242880
PHOTO_MAX_DIMENSION=2400
PHOTO_MAX_PER_NODE=8
PHOTO_MAX_ROWS=10000
PHOTO_MAX_TOTAL_BYTES=2147483648
PHOTO_RATE_LIMIT=8
PHOTO_DAILY_LIMIT=30
PHOTO_COOLDOWN_MS=10000
PHOTO_REPORT_RATE_LIMIT=5
PHOTO_REPORT_COOLDOWN_MS=10000
# Token pro moderaci; když je prázdný, použije se FEEDBACK_TOKEN
PHOTO_TOKEN=

# Telegram upozornění pro správce
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_PHOTOS=1
TELEGRAM_NOTIFY_REPORTS=1
TELEGRAM_NOTIFY_FEEDBACK=0
# Posílat do zpráv i přímý odkaz do administrace včetně tokenu
TELEGRAM_ADMIN_LINK=0
TELEGRAM_SILENT=0
TELEGRAM_TIMEOUT_MS=5000
# Veřejná adresa aplikace pro odkazy v notifikacích
PUBLIC_BASE_URL=https://mapa.meshcore.cz

# Nastavte 1 jen pokud aplikace běží za důvěryhodnou proxy (nginx na loopbacku)
TRUST_PROXY=0

# Výšky terénu pro LOS (serverový proxy s cache a záložním poskytovatelem)
ELEVATION_UPSTREAM=https://api.open-meteo.com/v1/elevation
ELEVATION_FALLBACK_URL=https://api.open-elevation.com/api/v1/lookup
ELEVATION_CACHE_LIMIT=50000
ELEVATION_MAX_POINTS=200
ELEVATION_TIMEOUT_MS=10000

# Výškové dlaždice pro simulaci pokrytí (Mapzen Terrarium)
TERRAIN_UPSTREAM=https://s3.amazonaws.com/elevation-tiles-prod/terrarium
TERRAIN_CACHE_LIMIT=300
TERRAIN_CACHE_TTL_MS=604800000
TERRAIN_TIMEOUT_MS=10000
TERRAIN_RATE_LIMIT=600
TERRAIN_RATE_WINDOW_MS=600000

# Cache odpovědí CoreScope
NODES_CACHE_PATH=data/nodes-cache.json
NODES_CACHE_TTL_MS=604800000
NODES_SOFT_TTL_MS=900000
STATS_CACHE_PATH=data/stats-cache.json
STATS_CACHE_TTL_MS=86400000
STATS_SOFT_TTL_MS=60000
STATS_TIMEOUT_MS=5000
STATS_COLLECT_MS=300000
STATS_HISTORY_DAYS=30
